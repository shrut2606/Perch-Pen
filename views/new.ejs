<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perch & Pen</title>
    <!-- favicon -->
    <link rel="icon" href="/images/favicon.ico">
    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- bootstrap js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <!-- css -->
    <link rel="stylesheet" href="styles/new.css">
</head>
<body>

    <!-- navbar -->
    <nav class="navbar bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Perch & Pen</a>

        </div>
    </nav>

    <form action="/new" method="POST">
    <div class="mb-3">
        <label for="formGroupExampleInput" class="form-label">Title</label>
        <textarea  name="title" class="form-control" id="floatingTextarea" placeholder="Title"></textarea>
      </div>
      <div class="mb-3">
        <label for="formGroupExampleInput2" class="form-label">Subtitle</label>
        <textarea name="Subtitle" class="form-control" id="floatingTextarea" placeholder="Subtitle"></textarea>
      </div>
      <div class="mb-3">
        <label for="formGroupExampleInput2" class="form-label">Content</label>
        <textarea required name="body" class="form-control content" id="floatingTextarea" placeholder="Body"></textarea>
      </div>
      <input class="btn btn-success" type="submit" value="Save Note">
    </form>

</body>
</html>