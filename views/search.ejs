<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perch & Pen</title>
    <!-- favicon -->
    <link rel="icon" href="/images/favicon.ico">
    <!-- fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lobster&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- css -->
    <link rel="stylesheet" href="styles/home.css">
    <!-- bootstrap js -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    
    
</head>
<body>
    <% var i; %>
    <!-- navbar -->
    <!-- body -->

    <div class="row"> 
    <% for( var j=0;j<arr.length;j++){ 
        i=arr[j];%>

        <div class=" col-lg-3 col-md-6 col1">
        <div class="shadow-lg card" >
            
            <div class="card-body">
                 <div class="dropdown">
                    <button class="btn btn-sm btn-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <ul class="dropdown-menu">
                      <li><a class="dropdown-item edi" href="#" data-bs-toggle="modal" data-bs-target="#editNote" data-title="<%= data[i].title %>" data-subtitle="<%= data[i].subtitle %>" 
                        data-body="<%= data[i].content %> " data-index="<%= i %>">Edit</a></li>
                      <li><a class="dropdown-item del" href="/del/<%= i %>">Delete</a></li>
                    </ul>
                </div>
              
              <h5 class="card-title"><%= data[i].title.substring(0,10) %><% if(data[i].title.length>10) {%>..<% } %></h5>
              <h6 class="card-subtitle mb-2 text-body-secondary"><%=data[i].subtitle.substring(0,15)%><%if(data[i].subtitle.length>15) {%>..<% } %></h6>
              <p class="card-text"> <%=data[i].content.substring(0,100)%><%  if(data[i].content.length>100) {%>..<% } %>  </p>
              <p class="date">Edited on <%= data[i].date %></p>
            </div>
        </div>
    </div>
    <div class="modal fade" id="editNote" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h1 class="modal-title fs-5" id="modal-title">Edit Note</h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/save" method="post" >
            <textarea name="index" id="save"></textarea>
          <div class="modal-body">
            <div class="mb-3">
              <textarea  name="title" class="form-control" id="exampleModalLabel" placeholder="Title">xcvghjkl;</textarea>
            </div>
            <div class="mb-3">
             <textarea name="subtitle" class="form-control" id="exampleModalsublabel" placeholder="Subtitle">aaaaaaaaaaaaaaaaaaa</textarea>
            </div>
            <div class="mb-3">
              <textarea required name="body" class="form-control content" id="modal-body" placeholder="Body">aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</textarea>
            </div> 
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success">Save changes</button>
          </div>
        </form>
        </div>
      </div>
    </div>
    <% } %>
    </div>
    
     <!-- javascript -->
    <script src="script/edit.js"></script>
</body>
</html>